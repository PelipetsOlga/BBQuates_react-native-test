{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "#/app/*": ["./src/app/*"],
      "#/features/*": ["./src/features/*"],
      "#/libs/*": ["./src/libs/*"],
      "#/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
